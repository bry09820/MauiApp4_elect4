<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MauiApp4_elect4"
             x:Class="MauiApp4_elect4.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ═══════════════════════════════════════════════════════
                 MODERN GROCERY APP · FOREST GREEN & FRESH PRODUCE THEME
                 ═══════════════════════════════════════════════════════ -->

            <!-- ── Surfaces ──────────────────────────────────────────── -->
            <Color x:Key="PageBg">#F7F9FB</Color>
            <Color x:Key="CardBg">#FFFFFF</Color>
            <Color x:Key="CardBgElevated">#F1F5F9</Color>
            <Color x:Key="CardBorder">#E8ECF2</Color>
            <Color x:Key="CardBorderLight">#F0F3F6</Color>

            <!-- ── Brand Accents ─────────────────────────────────────── -->
            <!-- Forest Green — Primary Accent, Navigation, Add Buttons, Checkout -->
            <Color x:Key="BrandGreen">#1E6B39</Color>
            <Color x:Key="BrandGreenLight">#EBF6EE</Color>
            <Color x:Key="BrandGreenMid">#2B7A4B</Color>
            <Color x:Key="BrandGreenDark">#15522A</Color>
            <Color x:Key="BrandGreenBadge">#23864A</Color>

            <!-- Emerald & Fresh Accents -->
            <Color x:Key="StatusGreen">#1E6B39</Color>
            <Color x:Key="StatusGreenLight">#EBF6EE</Color>

            <!-- Accent Palette -->
            <Color x:Key="AccentAmber">#F59E0B</Color>
            <Color x:Key="AccentAmberLight">#FEF3C7</Color>
            <Color x:Key="AccentRed">#EF4444</Color>
            <Color x:Key="AccentRedLight">#FEE2E2</Color>
            <Color x:Key="AccentBlue">#3B82F6</Color>
            <Color x:Key="AccentBlueLight">#EFF6FF</Color>

            <!-- ── Typography Colors ─────────────────────────────────── -->
            <Color x:Key="TextPrimary">#1A202C</Color>
            <Color x:Key="TextSecondary">#718096</Color>
            <Color x:Key="TextMuted">#A0AEC0</Color>
            <Color x:Key="TextWhite">#FFFFFF</Color>
            <Color x:Key="BrandDark">#1A202C</Color>

            <!-- ── Shadows ────────────────────────────────────────────── -->
            <Shadow x:Key="CardShadow"
                    Brush="#14000000"
                    Offset="0,3"
                    Radius="10"
                    Opacity="0.8" />

            <Shadow x:Key="CardShadowHover"
                    Brush="#1F000000"
                    Offset="0,6"
                    Radius="16"
                    Opacity="0.85" />

            <Shadow x:Key="FloatShadow"
                    Brush="#25000000"
                    Offset="0,8"
                    Radius="20"
                    Opacity="0.9" />

            <Shadow x:Key="GreenGlowShadow"
                    Brush="#4D1E6B39"
                    Offset="0,4"
                    Radius="14"
                    Opacity="0.8" />

            <!-- ── Typography Sizes ─────────────────────────────────── -->
            <x:Double x:Key="FontH1">24</x:Double>
            <x:Double x:Key="FontH2">20</x:Double>
            <x:Double x:Key="FontH3">17</x:Double>
            <x:Double x:Key="FontBody">14</x:Double>
            <x:Double x:Key="FontCaption">12</x:Double>
            <x:Double x:Key="FontMicro">11</x:Double>

            <!-- ── Corner Radii ─────────────────────────────────────── -->
            <x:Double x:Key="RadiusSm">10</x:Double>
            <x:Double x:Key="RadiusMd">14</x:Double>
            <x:Double x:Key="RadiusLg">18</x:Double>
            <x:Double x:Key="RadiusXl">24</x:Double>
            <x:Double x:Key="RadiusPill">50</x:Double>

            <!-- ── Reusable Component Styles ────────────────────────── -->

            <!-- Primary Forest Green Button -->
            <Style x:Key="BtnPrimary" TargetType="Button">
                <Setter Property="BackgroundColor"  Value="{StaticResource BrandGreen}" />
                <Setter Property="TextColor"         Value="{StaticResource TextWhite}" />
                <Setter Property="FontAttributes"    Value="Bold" />
                <Setter Property="FontSize"          Value="{StaticResource FontBody}" />
                <Setter Property="CornerRadius"      Value="16" />
                <Setter Property="HeightRequest"     Value="50" />
                <Setter Property="Padding"           Value="0" />
                <Setter Property="Shadow"            Value="{StaticResource GreenGlowShadow}" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="Scale"   Value="1.0" />
                                    <Setter Property="Opacity" Value="1.0" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale"   Value="0.97" />
                                    <Setter Property="Opacity" Value="0.90" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.45" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!-- Secondary / Outlined Button -->
            <Style x:Key="BtnSecondary" TargetType="Button">
                <Setter Property="BackgroundColor"  Value="{StaticResource CardBg}" />
                <Setter Property="TextColor"         Value="{StaticResource TextPrimary}" />
                <Setter Property="FontAttributes"    Value="Bold" />
                <Setter Property="FontSize"          Value="{StaticResource FontBody}" />
                <Setter Property="CornerRadius"      Value="16" />
                <Setter Property="HeightRequest"     Value="50" />
                <Setter Property="BorderColor"       Value="{StaticResource CardBorder}" />
                <Setter Property="BorderWidth"       Value="1.2" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="Scale"   Value="1.0" />
                                    <Setter Property="Opacity" Value="1.0" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale"   Value="0.97" />
                                    <Setter Property="Opacity" Value="0.85" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!-- Brand Green Button Alias -->
            <Style x:Key="BtnGreen" TargetType="Button">
                <Setter Property="BackgroundColor"  Value="{StaticResource BrandGreen}" />
                <Setter Property="TextColor"         Value="{StaticResource TextWhite}" />
                <Setter Property="FontAttributes"    Value="Bold" />
                <Setter Property="FontSize"          Value="{StaticResource FontBody}" />
                <Setter Property="CornerRadius"      Value="14" />
                <Setter Property="HeightRequest"     Value="44" />
                <Setter Property="Padding"           Value="12,0" />
                <Setter Property="Shadow"            Value="{StaticResource GreenGlowShadow}" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="Scale"   Value="1.0" />
                                    <Setter Property="Opacity" Value="1.0" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale"   Value="0.96" />
                                    <Setter Property="Opacity" Value="0.90" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!-- Small Action Button (+ Add) -->
            <Style x:Key="BtnAddSmall" TargetType="Button">
                <Setter Property="BackgroundColor"  Value="{StaticResource BrandGreen}" />
                <Setter Property="TextColor"         Value="{StaticResource TextWhite}" />
                <Setter Property="FontAttributes"    Value="Bold" />
                <Setter Property="FontSize"          Value="12" />
                <Setter Property="CornerRadius"      Value="10" />
                <Setter Property="HeightRequest"     Value="32" />
                <Setter Property="Padding"           Value="10,0" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="Scale"   Value="1.0" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale"   Value="0.92" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!-- Small Stepper Circle Button (+ / -) -->
            <Style x:Key="BtnIconSmall" TargetType="Button">
                <Setter Property="CornerRadius"   Value="8" />
                <Setter Property="WidthRequest"   Value="30" />
                <Setter Property="HeightRequest"  Value="30" />
                <Setter Property="Padding"        Value="0" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize"       Value="15" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="Scale"   Value="1.0" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale"   Value="0.90" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!-- Clean Modern White Card Container -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource CardBg}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Stroke"           Value="{StaticResource CardBorder}" />
                <Setter Property="StrokeShape"      Value="RoundRectangle 14" />
                <Setter Property="Shadow"           Value="{StaticResource CardShadow}" />
                <Setter Property="Padding"          Value="14" />
            </Style>

            <!-- Section Heading Label -->
            <Style x:Key="SectionLabel" TargetType="Label">
                <Setter Property="FontSize"       Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor"      Value="{StaticResource TextPrimary}" />
            </Style>

            <!-- Subtle Muted Caption -->
            <Style x:Key="CaptionLabel" TargetType="Label">
                <Setter Property="FontSize"  Value="{StaticResource FontCaption}" />
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
            </Style>

            <!-- Form Field Entry Wrapper -->
            <Style x:Key="InputBorder" TargetType="Border">
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Stroke"           Value="{StaticResource CardBorder}" />
                <Setter Property="StrokeShape"      Value="RoundRectangle 12" />
                <Setter Property="BackgroundColor"  Value="{StaticResource CardBgElevated}" />
                <Setter Property="Padding"          Value="12,0" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
