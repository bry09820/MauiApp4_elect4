<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp4_elect4.Views.OrderDetailsPage"
             Title="Order Details"
             BackgroundColor="{StaticResource PageBg}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="True">

    <Grid RowDefinitions="Auto,*">

        <!-- ══ 1 · FOREST GREEN TOP HEADER ═════════════════════ -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource BrandGreen}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 0,0,24,24"
                Padding="16,14,16,16">
            <Border.Shadow>
                <Shadow Brush="#331E6B39" Offset="0,4" Radius="12" Opacity="0.5" />
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                <!-- Back Button -->
                <Border Grid.Column="0"
                        BackgroundColor="#2D7F4C"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        WidthRequest="40"
                        HeightRequest="40">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="←"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextWhite}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- Header Title & Order Number -->
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                    <Label Text="Order Details"
                           FontSize="19"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextWhite}"
                           HorizontalOptions="Center" />
                    <Label x:Name="OrderIdHeaderLabel"
                           Text="#104"
                           FontSize="12"
                           TextColor="#D2ECD8"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <BoxView Grid.Column="2" WidthRequest="40" Color="Transparent" />
            </Grid>
        </Border>

        <!-- ══ 2 · SCROLLABLE CONTENT BODY ═════════════════════ -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,14,16,24" Spacing="14">

                <!-- ── Vendor & Delivery Status Card ── -->
                <Border BackgroundColor="{StaticResource CardBg}"
                        StrokeThickness="1"
                        Stroke="{StaticResource CardBorder}"
                        StrokeShape="RoundRectangle 16"
                        Padding="14,12">
                    <Border.Shadow>
                        <Shadow Brush="#10000000" Offset="0,2" Radius="6" Opacity="0.5" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="6">
                        <!-- Vendor Logo & Name -->
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Border BackgroundColor="{StaticResource BrandGreenLight}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    WidthRequest="32"
                                    HeightRequest="32">
                                <Label x:Name="VendorIconLabel"
                                       Text="🌿"
                                       FontSize="16"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Label x:Name="VendorNameLabel"
                                   Text="GreenMarket"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!-- Status Indicator -->
                        <HorizontalStackLayout Spacing="6" Margin="0,2,0,0">
                            <Label Text="◇"
                                   FontSize="12"
                                   TextColor="{StaticResource BrandGreen}"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                            <Label x:Name="OrderStatusLabel"
                                   Text="Out for Delivery"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource BrandGreen}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ── Delivery Address Card ── -->
                <Border BackgroundColor="{StaticResource CardBg}"
                        StrokeThickness="1"
                        Stroke="{StaticResource CardBorder}"
                        StrokeShape="RoundRectangle 16"
                        Padding="14,12">
                    <Border.Shadow>
                        <Shadow Brush="#10000000" Offset="0,2" Radius="6" Opacity="0.5" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Delivery Address"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <Label x:Name="AddressDetailsLabel"
                               Text="742 Evergreen Terrace, Springfield, OR 97477"
                               FontSize="12"
                               TextColor="{StaticResource TextSecondary}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <!-- ── Items Delivery Card ── -->
                <Border BackgroundColor="{StaticResource CardBg}"
                        StrokeThickness="1"
                        Stroke="{StaticResource CardBorder}"
                        StrokeShape="RoundRectangle 16"
                        Padding="14,12">
                    <Border.Shadow>
                        <Shadow Brush="#10000000" Offset="0,2" Radius="6" Opacity="0.5" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Items Delivery"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />

                        <CollectionView x:Name="ItemsDetailsCollectionView"
                                        SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="10" Padding="0,5" VerticalOptions="Center">
                                        <Border Grid.Column="0"
                                                BackgroundColor="#F8FAFC"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 8"
                                                WidthRequest="42"
                                                HeightRequest="42">
                                            <Image Source="{Binding Product.ImageUrl}"
                                                   Aspect="AspectFill" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding Product.Name}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource TextPrimary}" />
                                            <HorizontalStackLayout Spacing="4">
                                                <Label Text="✓" FontSize="9" TextColor="{StaticResource BrandGreen}" FontAttributes="Bold" VerticalOptions="Center" />
                                                <Label Text="{Binding Quantity, StringFormat='{0} - 1.0kg'}"
                                                       FontSize="10"
                                                       TextColor="{StaticResource TextSecondary}"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <Label Grid.Column="2"
                                               Text="{Binding Subtotal, StringFormat='${0:F2}'}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- ── Order Summary Card ── -->
                <Border BackgroundColor="{StaticResource CardBg}"
                        StrokeThickness="1"
                        Stroke="{StaticResource CardBorder}"
                        StrokeShape="RoundRectangle 16"
                        Padding="14,12">
                    <Border.Shadow>
                        <Shadow Brush="#10000000" Offset="0,2" Radius="6" Opacity="0.5" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="Order Summary"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Total" FontSize="12" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                                <Label x:Name="SummaryTotalTopLabel"
                                       Text="$13.08"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource CardBorder}" />

                        <!-- Subtotal -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Subtotal" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            <Label x:Name="SubtotalLabel" Grid.Column="1" Text="$11.99" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        </Grid>

                        <!-- Delivery Fee -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Delivery Fee" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            <Label x:Name="DeliveryFeeLabel" Grid.Column="1" Text="$1.09" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource CardBorder}" />

                        <!-- Total Amount -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Total Amount" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Label x:Name="TotalAmountLabel" Grid.Column="1" Text="$13.08" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ── Courier Driver Contact Card ── -->
                <Border BackgroundColor="{StaticResource CardBg}"
                        StrokeThickness="1"
                        Stroke="{StaticResource CardBorder}"
                        StrokeShape="RoundRectangle 16"
                        Padding="12,10">
                    <Border.Shadow>
                        <Shadow Brush="#10000000" Offset="0,2" Radius="6" Opacity="0.5" />
                    </Border.Shadow>

                    <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                        <!-- Courier Avatar -->
                        <Border Grid.Column="0"
                                StrokeThickness="1.5"
                                Stroke="{StaticResource BrandGreen}"
                                StrokeShape="RoundRectangle 24"
                                WidthRequest="48"
                                HeightRequest="48"
                                Padding="0">
                            <Image Source="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=300&amp;auto=format&amp;fit=crop&amp;q=80"
                                   Aspect="AspectFill"
                                   WidthRequest="48"
                                   HeightRequest="48">
                                <Image.Clip>
                                    <RoundRectangleGeometry CornerRadius="24" Rect="0,0,48,48" />
                                </Image.Clip>
                            </Image>
                        </Border>

                        <!-- Details -->
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label x:Name="CourierNameLabel"
                                   Text="Mike Roberts"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Label Text="⭐ 4.9 • Delivery Partner"
                                   FontSize="11"
                                   TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>

                        <!-- Green Call Button -->
                        <Button Grid.Column="2"
                                Text="📞 Call"
                                BackgroundColor="{StaticResource BrandGreen}"
                                TextColor="{StaticResource TextWhite}"
                                FontSize="12"
                                FontAttributes="Bold"
                                CornerRadius="12"
                                HeightRequest="38"
                                Padding="14,0"
                                Clicked="OnCallCourierClicked" />
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
