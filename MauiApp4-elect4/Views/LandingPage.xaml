<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp4_elect4.Views.LandingPage"
             Title=""
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource PageBg}">

    <!-- ═══════════════════════════════════════════════════════
         LANDING PAGE · Forest Green & Fresh Groceries Hero
         ═══════════════════════════════════════════════════════ -->

    <Grid>
        <!-- Background Ambient Glow Blobs -->
        <AbsoluteLayout InputTransparent="True">
            <Ellipse AbsoluteLayout.LayoutBounds="0.1, 0.05, 320, 320"
                     AbsoluteLayout.LayoutFlags="PositionProportional"
                     Fill="#1AEBF6EE" />

            <Ellipse AbsoluteLayout.LayoutBounds="0.9, 0.90, 280, 280"
                     AbsoluteLayout.LayoutFlags="PositionProportional"
                     Fill="#1A1E6B39" />

            <Ellipse AbsoluteLayout.LayoutBounds="0.5, 0.45, 360, 360"
                     AbsoluteLayout.LayoutFlags="PositionProportional"
                     Fill="#122ECC71" />
        </AbsoluteLayout>

        <!-- Main Content Grid Layout -->
        <Grid x:Name="ContentStack"
              RowDefinitions="Auto, Auto, Auto, *, Auto, Auto"
              Padding="26,44,26,32"
              Opacity="0"
              Scale="0.94">

            <!-- Row 0: Top Luxury Pill Badge -->
            <Border Grid.Row="0"
                    BackgroundColor="{StaticResource BrandGreenLight}"
                    Stroke="#CDE8D5"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    Padding="14,6"
                    HorizontalOptions="Start"
                    Margin="0,0,0,14">
                <HorizontalStackLayout Spacing="6">
                    <Label Text="🌿" FontSize="13" VerticalOptions="Center" />
                    <Label Text="FRESH &amp; ORGANIC GROCERIES"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{StaticResource BrandGreen}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- Row 1: Hero Heading -->
            <Label Grid.Row="1"
                   FontSize="34"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   LineHeight="1.15"
                   HorizontalOptions="Start"
                   Margin="0,0,0,10">
                <Label.Text>Fresh Groceries.
Delivered Fast.</Label.Text>
            </Label>

            <!-- Row 2: Subtitle -->
            <Label Grid.Row="2"
                   Text="Explore fresh organic produce, farm-to-table dairy, and premium grocery essentials delivered to your doorstep in minutes."
                   FontSize="13"
                   TextColor="{StaticResource TextSecondary}"
                   LineHeight="1.4"
                   HorizontalOptions="Start"
                   Margin="0,0,0,16" />

            <!-- Row 3: Central Plate Container with Ambient Glow & Floating Badges -->
            <Grid Grid.Row="3"
                  VerticalOptions="Center"
                  HorizontalOptions="Center"
                  WidthRequest="310"
                  HeightRequest="270">

                <!-- Ambient Glow Ring -->
                <Ellipse Fill="#251E6B39"
                         WidthRequest="230"
                         HeightRequest="230"
                         HorizontalOptions="Center"
                         VerticalOptions="Center" />

                <!-- Central Dish Plate Card -->
                <Border BackgroundColor="{StaticResource CardBg}"
                        Stroke="#E8ECF2"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 110"
                        WidthRequest="220"
                        HeightRequest="220"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                    <Border.Shadow>
                        <Shadow Brush="#331E6B39" Offset="0,10" Radius="30" Opacity="0.4" />
                    </Border.Shadow>

                    <!-- Inner Glow Ring -->
                    <Border BackgroundColor="{StaticResource BrandGreenLight}"
                            Stroke="{StaticResource BrandGreen}"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 100"
                            WidthRequest="196"
                            HeightRequest="196"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                        <Label Text="🥑"
                               FontSize="82"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </Border>

                <!-- Floating Tag 1: Top Right Rating Tag -->
                <Border BackgroundColor="{StaticResource CardBg}"
                        Stroke="#2ECC71"
                        StrokeThickness="1.2"
                        StrokeShape="RoundRectangle 16"
                        Padding="10,6"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        Margin="0,12,6,0">
                    <Border.Shadow>
                        <Shadow Brush="#222ECC71" Offset="0,4" Radius="14" Opacity="0.4" />
                    </Border.Shadow>
                    <HorizontalStackLayout Spacing="4">
                        <Label Text="⭐" FontSize="11" VerticalOptions="Center" />
                        <Label Text="4.9 Rated"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{StaticResource BrandGreen}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Floating Tag 2: Bottom Left Speed Tag -->
                <Border BackgroundColor="{StaticResource CardBg}"
                        Stroke="{StaticResource BrandGreen}"
                        StrokeThickness="1.2"
                        StrokeShape="RoundRectangle 16"
                        Padding="10,6"
                        HorizontalOptions="Start"
                        VerticalOptions="End"
                        Margin="4,0,0,16">
                    <Border.Shadow>
                        <Shadow Brush="#331E6B39" Offset="0,4" Radius="14" Opacity="0.4" />
                    </Border.Shadow>
                    <HorizontalStackLayout Spacing="4">
                        <Label Text="⚡" FontSize="11" VerticalOptions="Center" />
                        <Label Text="15-30 min"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{StaticResource BrandGreen}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- Row 4: Carousel Dot indicators -->
            <HorizontalStackLayout Grid.Row="4"
                                   HorizontalOptions="Center"
                                   Spacing="8"
                                   Margin="0,10,0,20">
                <Border BackgroundColor="{StaticResource BrandGreen}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 4"
                        WidthRequest="26"
                        HeightRequest="6" />
                <Ellipse Fill="#CBD5E1" WidthRequest="6" HeightRequest="6" />
                <Ellipse Fill="#CBD5E1" WidthRequest="6" HeightRequest="6" />
            </HorizontalStackLayout>

            <!-- Row 5: Get Started Full Pill Button -->
            <Button Grid.Row="5"
                    x:Name="GetStartedButton"
                    Text="Explore Shops  →"
                    BackgroundColor="{StaticResource BrandGreen}"
                    TextColor="{StaticResource TextWhite}"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="28"
                    HeightRequest="56"
                    HorizontalOptions="Fill"
                    Clicked="OnGetStartedClicked">
                <Button.Shadow>
                    <Shadow Brush="#4D1E6B39" Offset="0,6" Radius="20" Opacity="0.45" />
                </Button.Shadow>
            </Button>

        </Grid>
    </Grid>
</ContentPage>
