<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp4_elect4.Views.ExploreShopsPage"
             Title="Explore Shops"
             BackgroundColor="{StaticResource PageBg}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="True">

    <!-- ═══════════════════════════════════════════════════════
         ROOT GRID — Top Header + Scrollable Content Body
         ═══════════════════════════════════════════════════════ -->
    <Grid RowDefinitions="Auto,*">

        <!-- ══ 1 · FOREST GREEN TOP HEADER & ADDRESS SEARCH ══ -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource BrandGreen}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 0,0,24,24"
                Padding="16,14,16,18">
            <Border.Shadow>
                <Shadow Brush="#331E6B39" Offset="0,4" Radius="12" Opacity="0.5" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="12">
                <!-- Top Row: Address Selector ("Deliver to...") + Heart & Cart/Info Actions -->
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Deliver to"
                               FontSize="11"
                               TextColor="#D2ECD8" />
                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label Text="📍 742 Evergreen Terrace..."
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextWhite}"
                                   MaxLines="1"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="▾"
                                   FontSize="13"
                                   TextColor="{StaticResource TextWhite}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Heart / Favorites Button -->
                    <Border Grid.Column="1"
                            BackgroundColor="#2D7F4C"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18"
                            WidthRequest="36"
                            HeightRequest="36">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFavoritesTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="♡"
                               FontSize="18"
                               TextColor="{StaticResource TextWhite}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <!-- Info / Profile Button -->
                    <Border Grid.Column="2"
                            BackgroundColor="#2D7F4C"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18"
                            WidthRequest="36"
                            HeightRequest="36">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnInfoTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="ⓘ"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextWhite}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- Search Address Capsule Input Bar -->
                <Border BackgroundColor="{StaticResource CardBg}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 22"
                        Padding="14,0"
                        HeightRequest="44">
                    <Border.Shadow>
                        <Shadow Brush="#1A000000" Offset="0,2" Radius="6" Opacity="0.4" />
                    </Border.Shadow>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0"
                               Text="🔍"
                               FontSize="14"
                               TextColor="{StaticResource TextSecondary}"
                               VerticalOptions="Center" />
                        <Entry x:Name="SearchAddressEntry"
                               Grid.Column="1"
                               Placeholder="Search groceries, stores, produce..."
                               PlaceholderColor="{StaticResource TextMuted}"
                               FontSize="13"
                               TextColor="{StaticResource TextPrimary}"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center"
                               TextChanged="OnSearchTextChanged" />
                        <!-- Location / Filter Pin Icon -->
                        <Label Grid.Column="2"
                               Text="📍"
                               FontSize="15"
                               TextColor="{StaticResource BrandGreen}"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAddressPinTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </Border>

        <!-- ══ 2 · SCROLLABLE CONTENT BODY ═════════════════════ -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,14,16,24" Spacing="16">

                <!-- ── Hero Promo Banner Card: "Fresh Delivery to Your Door" ── -->
                <Border BackgroundColor="{StaticResource BrandGreenMid}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18"
                        Padding="16,14"
                        HeightRequest="120">
                    <Border.Shadow>
                        <Shadow Brush="#261E6B39" Offset="0,4" Radius="12" Opacity="0.5" />
                    </Border.Shadow>
                    <Grid ColumnDefinitions="*,110">
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="4">
                            <Label Text="Fresh Delivery"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextWhite}" />
                            <Label Text="to Your Door"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextWhite}" />
                            <Label Text="Get 20% off your first order"
                                   FontSize="11"
                                   TextColor="#D2ECD8"
                                   Margin="0,2,0,0" />
                        </VerticalStackLayout>

                        <!-- Produce Basket Graphic / Image -->
                        <Image Grid.Column="1"
                               Source="https://images.unsplash.com/photo-1542838132-92c53300491e?w=300&amp;auto=format&amp;fit=crop&amp;q=80"
                               Aspect="AspectFill"
                               WidthRequest="100"
                               HeightRequest="90"
                               HorizontalOptions="End"
                               VerticalOptions="Center">
                            <Image.Clip>
                                <RoundRectangleGeometry CornerRadius="12" Rect="0,0,100,90" />
                            </Image.Clip>
                        </Image>
                    </Grid>
                </Border>

                <!-- ── 4 Category Icon Cards Grid ── -->
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">

                    <!-- 1 · Fruits -->
                    <Border Grid.Column="0"
                            BackgroundColor="{StaticResource CardBg}"
                            StrokeThickness="1"
                            Stroke="{StaticResource CardBorder}"
                            StrokeShape="RoundRectangle 14"
                            Padding="6,10"
                            HeightRequest="86">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCategoryCardTapped" CommandParameter="Fruits" />
                        </Border.GestureRecognizers>
                        <Border.Shadow>
                            <Shadow Brush="#10000000" Offset="0,2" Radius="6" Opacity="0.7" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="🍎" FontSize="26" HorizontalOptions="Center" />
                            <Label Text="Fruits" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- 2 · Vegetables -->
                    <Border Grid.Column="1"
                            BackgroundColor="{StaticResource CardBg}"
                            StrokeThickness="1"
                            Stroke="{StaticResource CardBorder}"
                            StrokeShape="RoundRectangle 14"
                            Padding="6,10"
                            HeightRequest="86">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCategoryCardTapped" CommandParameter="Vegetables" />
                        </Border.GestureRecognizers>
                        <Border.Shadow>
                            <Shadow Brush="#10000000" Offset="0,2" Radius="6" Opacity="0.7" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="🥦" FontSize="26" HorizontalOptions="Center" />
                            <Label Text="Vegetables" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- 3 · Dairy -->
                    <Border Grid.Column="2"
                            BackgroundColor="{StaticResource CardBg}"
                            StrokeThickness="1"
                            Stroke="{StaticResource CardBorder}"
                            StrokeShape="RoundRectangle 14"
                            Padding="6,10"
                            HeightRequest="86">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCategoryCardTapped" CommandParameter="Dairy" />
                        </Border.GestureRecognizers>
                        <Border.Shadow>
                            <Shadow Brush="#10000000" Offset="0,2" Radius="6" Opacity="0.7" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="🥛" FontSize="26" HorizontalOptions="Center" />
                            <Label Text="Dairy" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- 4 · Snacks -->
                    <Border Grid.Column="3"
                            BackgroundColor="{StaticResource CardBg}"
                            StrokeThickness="1"
                            Stroke="{StaticResource CardBorder}"
                            StrokeShape="RoundRectangle 14"
                            Padding="6,10"
                            HeightRequest="86">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCategoryCardTapped" CommandParameter="Snacks" />
                        </Border.GestureRecognizers>
                        <Border.Shadow>
                            <Shadow Brush="#10000000" Offset="0,2" Radius="6" Opacity="0.7" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="🥐" FontSize="26" HorizontalOptions="Center" />
                            <Label Text="Snacks" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- ── "Top Vendors" Section ── -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                    <Label Grid.Column="0"
                           Text="Top Vendors"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="See All &gt;"
                           FontSize="12"
                           TextColor="{StaticResource TextSecondary}"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSeeAllVendorsTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <!-- Horizontal Vendor Cards CollectionView -->
                <CollectionView x:Name="TopVendorsCollectionView"
                                HeightRequest="130"
                                SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border WidthRequest="165"
                                    HeightRequest="125"
                                    BackgroundColor="{StaticResource CardBg}"
                                    StrokeThickness="1"
                                    Stroke="{StaticResource CardBorder}"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnVendorCardTapped" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Border.Shadow>
                                    <Shadow Brush="#14000000" Offset="0,2" Radius="8" Opacity="0.6" />
                                </Border.Shadow>

                                <Grid RowDefinitions="*,Auto">
                                    <!-- Store Image -->
                                    <Image Grid.Row="0"
                                           Grid.RowSpan="2"
                                           Source="{Binding ImageUrl}"
                                           Aspect="AspectFill" />

                                    <!-- Dark Gradient Overlay for store details -->
                                    <BoxView Grid.Row="0"
                                             Grid.RowSpan="2"
                                             Color="#88000000" />

                                    <!-- Details & Delivery Badge -->
                                    <Grid Grid.Row="1"
                                          ColumnDefinitions="*,Auto"
                                          Padding="10,6,10,8"
                                          VerticalOptions="End">
                                        <VerticalStackLayout Grid.Column="0" Spacing="1">
                                            <Label Text="{Binding Name}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource TextWhite}" />
                                            <!-- 5 Yellow Rating Stars -->
                                            <HorizontalStackLayout Spacing="1">
                                                <Label Text="★★★★★"
                                                       FontSize="11"
                                                       TextColor="{StaticResource AccentAmber}" />
                                                <Label Text="{Binding Rating, StringFormat=' {0:F1}'}"
                                                       FontSize="10"
                                                       TextColor="{StaticResource TextWhite}" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <!-- Delivery Time Pill Badge -->
                                        <Border Grid.Column="1"
                                                BackgroundColor="{StaticResource BrandGreen}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 10"
                                                Padding="6,3"
                                                VerticalOptions="End">
                                            <Label Text="{Binding DeliveryTime}"
                                                   FontSize="9"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource TextWhite}" />
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- ── "Popular Deals" Section ── -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <Label Grid.Column="0"
                           Text="Popular Deals"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="See All &gt;"
                           FontSize="12"
                           TextColor="{StaticResource TextSecondary}"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSeeAllDealsTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <!-- 2-Column Product Grid -->
                <CollectionView x:Name="PopularDealsCollectionView"
                                SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical"
                                         Span="2"
                                         HorizontalItemSpacing="10"
                                         VerticalItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{StaticResource CardBg}"
                                    StrokeThickness="1"
                                    Stroke="{StaticResource CardBorder}"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="10">
                                <Border.Shadow>
                                    <Shadow Brush="#10000000" Offset="0,2" Radius="6" Opacity="0.6" />
                                </Border.Shadow>

                                <VerticalStackLayout Spacing="6" VerticalOptions="FillAndExpand">
                                    <!-- Product Image Container -->
                                    <Border BackgroundColor="#F8FAFC"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 12"
                                            HeightRequest="105"
                                            Padding="0">
                                        <Image Source="{Binding ImageUrl}"
                                               Aspect="AspectFill"
                                               HeightRequest="105" />
                                    </Border>

                                    <!-- Product Name -->
                                    <Label Text="{Binding Name}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}"
                                           MaxLines="1"
                                           LineBreakMode="TailTruncation" />

                                    <!-- Weight / Unit -->
                                    <Label Text="{Binding Weight}"
                                           FontSize="11"
                                           TextColor="{StaticResource TextSecondary}" />

                                    <!-- Price and Add Button Row -->
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                        <Label Grid.Column="0"
                                               Text="{Binding Price, StringFormat='${0:F2}'}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}"
                                               VerticalOptions="Center" />

                                        <!-- Green + Add Button -->
                                        <Button Grid.Column="1"
                                                Text="+ Add"
                                                Style="{StaticResource BtnAddSmall}"
                                                CommandParameter="{Binding .}"
                                                Clicked="OnAddToCartClicked" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
