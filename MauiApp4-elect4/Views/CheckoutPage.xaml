<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp4_elect4.Views.CheckoutPage"
             Title="Checkout"
             BackgroundColor="{StaticResource PageBg}">

    <ScrollView>
        <VerticalStackLayout Padding="16,14" Spacing="16">

            <!-- ══════════════════════════════════════════════════
                 SECTION 1 · ORDER SUMMARY CARD
                 ══════════════════════════════════════════════════ -->
            <Label Text="Order Summary"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   Margin="2,0" />

            <Border BackgroundColor="{StaticResource CardBg}"
                    StrokeThickness="1.2"
                    Stroke="{StaticResource CardBorder}"
                    StrokeShape="RoundRectangle 20"
                    Padding="18">
                <Border.Shadow>
                    <Shadow Brush="#55000000" Offset="0,4" Radius="14" Opacity="0.35" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="0">

                    <!-- Items list -->
                    <CollectionView x:Name="OrderItemsView"
                                    SelectionMode="None"
                                    ItemSizingStrategy="MeasureFirstItem">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                                    <Label Grid.Column="0"
                                           Text="{Binding Product.Name}"
                                           FontSize="13"
                                           TextColor="{StaticResource TextSecondary}"
                                           LineBreakMode="WordWrap" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Subtotal, StringFormat='${0:F2}'}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource BrandGreen}"
                                           VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <BoxView HeightRequest="1" Color="{StaticResource CardBorder}" Margin="0,8" />

                    <!-- Scheduled delivery -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                        <Label Grid.Column="0"
                               Text="Scheduled Delivery"
                               FontSize="13"
                               TextColor="{StaticResource TextSecondary}"
                               VerticalOptions="Center" />
                        <Label x:Name="ScheduledLabel"
                               Grid.Column="1"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                    </Grid>

                    <!-- Subtotal -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,5">
                        <Label Grid.Column="0"
                               Text="Subtotal"
                               FontSize="13"
                               TextColor="{StaticResource TextSecondary}" />
                        <Label x:Name="SummarySubtotalLabel"
                               Grid.Column="1"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                    </Grid>

                    <!-- Delivery fee -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,5">
                        <Label Grid.Column="0"
                               Text="Delivery Fee"
                               FontSize="13"
                               TextColor="{StaticResource TextSecondary}" />
                        <Label x:Name="SummaryDeliveryFeeLabel"
                               Grid.Column="1"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource CardBorder}" Margin="0,4" />

                    <!-- Grand total -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="Grand Total"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <Label x:Name="SummaryTotalLabel"
                               Grid.Column="1"
                               FontSize="19"
                               FontAttributes="Bold"
                               TextColor="{StaticResource BrandGreen}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ══════════════════════════════════════════════════
                 SECTION 2 · SHIPPING DETAILS CARD
                 ══════════════════════════════════════════════════ -->
            <Label Text="Delivery Details"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   Margin="2,0" />

            <Border BackgroundColor="{StaticResource CardBg}"
                    StrokeThickness="1.2"
                    Stroke="{StaticResource CardBorder}"
                    StrokeShape="RoundRectangle 20"
                    Padding="18">
                <Border.Shadow>
                    <Shadow Brush="#55000000" Offset="0,4" Radius="14" Opacity="0.35" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="14">

                    <!-- Full Name -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Full Name"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextSecondary}"
                               Margin="2,0" />
                        <Border Style="{StaticResource InputBorder}">
                            <Entry x:Name="FullNameEntry"
                                   Placeholder="e.g. Juan Dela Cruz"
                                   PlaceholderColor="{StaticResource TextMuted}"
                                   FontSize="14"
                                   TextColor="{StaticResource TextPrimary}"
                                   BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Contact Number -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Contact Number"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextSecondary}"
                               Margin="2,0" />
                        <Border Style="{StaticResource InputBorder}">
                            <Entry x:Name="ContactEntry"
                                   Placeholder="e.g. 09XX-XXX-XXXX"
                                   PlaceholderColor="{StaticResource TextMuted}"
                                   Keyboard="Telephone"
                                   FontSize="14"
                                   TextColor="{StaticResource TextPrimary}"
                                   BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Shipping Address -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Delivery Address"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextSecondary}"
                               Margin="2,0" />
                        <Border StrokeThickness="1.2"
                                Stroke="{StaticResource CardBorder}"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="{StaticResource CardBgElevated}"
                                Padding="14,6">
                            <Editor x:Name="AddressEditor"
                                    Placeholder="Unit, Street, Barangay, City"
                                    PlaceholderColor="{StaticResource TextMuted}"
                                    AutoSize="TextChanges"
                                    MinimumHeightRequest="72"
                                    FontSize="14"
                                    TextColor="{StaticResource TextPrimary}"
                                    BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ══════════════════════════════════════════════════
                 SECTION 3 · PAYMENT METHOD
                 ══════════════════════════════════════════════════ -->
            <Label Text="Payment Method"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   Margin="2,0" />

            <Border BackgroundColor="{StaticResource CardBg}"
                    StrokeThickness="1.2"
                    Stroke="{StaticResource CardBorder}"
                    StrokeShape="RoundRectangle 20"
                    Padding="18">
                <Border.Shadow>
                    <Shadow Brush="#55000000" Offset="0,4" Radius="14" Opacity="0.35" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="10">

                    <!-- GCash option card -->
                    <Border BackgroundColor="{StaticResource CardBgElevated}"
                            StrokeThickness="1.2"
                            Stroke="{StaticResource CardBorder}"
                            StrokeShape="RoundRectangle 16"
                            Padding="14,12">
                        <HorizontalStackLayout Spacing="12">
                            <RadioButton x:Name="RadioGCash"
                                         GroupName="Payment"
                                         Value="GCash"
                                         CheckedChanged="OnPaymentMethodChanged" />
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="📱  GCash / E-Wallet"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Label Text="Instant cashless transaction"
                                       FontSize="11"
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Cash on Delivery — selected by default, coral border -->
                    <Border BackgroundColor="{StaticResource BrandGreenLight}"
                            StrokeThickness="1.5"
                            Stroke="{StaticResource BrandGreen}"
                            StrokeShape="RoundRectangle 16"
                            Padding="14,12">
                        <HorizontalStackLayout Spacing="12">
                            <RadioButton x:Name="RadioCOD"
                                         GroupName="Payment"
                                         Value="Cash on Delivery"
                                         IsChecked="True"
                                         CheckedChanged="OnPaymentMethodChanged" />
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="💵  Cash on Delivery"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Label Text="Pay with cash when food arrives"
                                       FontSize="11"
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Credit Card option card -->
                    <Border BackgroundColor="{StaticResource CardBgElevated}"
                            StrokeThickness="1.2"
                            Stroke="{StaticResource CardBorder}"
                            StrokeShape="RoundRectangle 16"
                            Padding="14,12">
                        <HorizontalStackLayout Spacing="12">
                            <RadioButton x:Name="RadioCard"
                                         GroupName="Payment"
                                         Value="Credit Card"
                                         CheckedChanged="OnPaymentMethodChanged" />
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="💳  Credit / Debit Card"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Label Text="Visa, Mastercard, JCB"
                                       FontSize="11"
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Selected method indicator -->
                    <Label x:Name="SelectedPaymentLabel"
                           Text="Selected: Cash on Delivery"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource BrandGreen}"
                           Margin="2,2,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- ══════════════════════════════════════════════════
                 CONFIRM BUTTON
                 ══════════════════════════════════════════════════ -->
            <Button x:Name="ConfirmOrderButton"
                    Text="Place Order  →"
                    Style="{StaticResource BtnPrimary}"
                    HeightRequest="56"
                    CornerRadius="28"
                    Margin="0,4,0,24"
                    Clicked="OnConfirmOrderClicked">
                <Button.Shadow>
                    <Shadow Brush="#66FF6B4A" Offset="0,5" Radius="16" Opacity="0.45" />
                </Button.Shadow>
            </Button>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
