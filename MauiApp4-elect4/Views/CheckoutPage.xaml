<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp4_elect4.Views.CheckoutPage"
             Title="Checkout"
             BackgroundColor="{StaticResource PageBg}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="True">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ══ 1 · FOREST GREEN TOP HEADER ═════════════════════ -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource BrandGreen}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 0,0,24,24"
                Padding="16,14,16,16">
            <Border.Shadow>
                <Shadow Brush="#331E6B39" Offset="0,4" Radius="12" Opacity="0.5" />
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                <!-- Back Button -->
                <Border Grid.Column="0"
                        BackgroundColor="#2D7F4C"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        WidthRequest="40"
                        HeightRequest="40">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="←"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextWhite}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- Header Title -->
                <Label Grid.Column="1"
                       Text="Checkout"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextWhite}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />

                <!-- Spacer Placeholder -->
                <BoxView Grid.Column="2" WidthRequest="40" Color="Transparent" />
            </Grid>
        </Border>

        <!-- ══ 2 · SCROLLABLE CHECKOUT SECTIONS ════════════════ -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,14,16,18" Spacing="14">

                <!-- ── Delivery Address Card ── -->
                <Border BackgroundColor="{StaticResource CardBg}"
                        StrokeThickness="1"
                        Stroke="{StaticResource CardBorder}"
                        StrokeShape="RoundRectangle 16"
                        Padding="14,12">
                    <Border.Shadow>
                        <Shadow Brush="#10000000" Offset="0,2" Radius="6" Opacity="0.5" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="Delivery Address"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="Change &gt;"
                                   FontSize="12"
                                   TextColor="{StaticResource BrandGreen}"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnChangeAddressTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <!-- Address preview box -->
                        <Border BackgroundColor="#F8FAFC"
                                StrokeThickness="1"
                                Stroke="{StaticResource CardBorder}"
                                StrokeShape="RoundRectangle 12"
                                Padding="12,10">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                <Label Grid.Column="0"
                                       Text="📍"
                                       FontSize="16"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       x:Name="AddressDisplayLabel"
                                       Text="742 Evergreen Terrace, Springfield, OR 97477"
                                       FontSize="13"
                                       TextColor="{StaticResource TextPrimary}"
                                       LineBreakMode="WordWrap"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2"
                                       Text="&gt;"
                                       FontSize="15"
                                       TextColor="{StaticResource TextSecondary}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- ── Delivery Method Selector Card ── -->
                <Border BackgroundColor="{StaticResource CardBg}"
                        StrokeThickness="1"
                        Stroke="{StaticResource CardBorder}"
                        StrokeShape="RoundRectangle 16"
                        Padding="14,12">
                    <Border.Shadow>
                        <Shadow Brush="#10000000" Offset="0,2" Radius="6" Opacity="0.5" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Delivery Method"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />

                        <!-- Option 1: Home Delivery (Selected) -->
                        <Border x:Name="HomeDeliveryCard"
                                BackgroundColor="#F8FAFC"
                                StrokeThickness="1.5"
                                Stroke="{StaticResource BrandGreen}"
                                StrokeShape="RoundRectangle 12"
                                Padding="12,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnHomeDeliverySelected" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                <!-- Green Truck Badge -->
                                <Border Grid.Column="0"
                                        BackgroundColor="{StaticResource BrandGreenLight}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8"
                                        WidthRequest="36"
                                        HeightRequest="36">
                                    <Label Text="🚚"
                                           FontSize="18"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>

                                <Label Grid.Column="1"
                                       Text="Home Delivery"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"
                                       VerticalOptions="Center" />

                                <!-- Checked Box -->
                                <Border Grid.Column="2"
                                        x:Name="HomeDeliveryCheckBorder"
                                        BackgroundColor="{StaticResource BrandGreen}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 6"
                                        WidthRequest="22"
                                        HeightRequest="22">
                                    <Label x:Name="HomeDeliveryCheckMark"
                                           Text="✓"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextWhite}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Option 2: Pickup (Unselected) -->
                        <Border x:Name="PickupCard"
                                BackgroundColor="#F8FAFC"
                                StrokeThickness="1"
                                Stroke="{StaticResource CardBorder}"
                                StrokeShape="RoundRectangle 12"
                                Padding="12,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPickupSelected" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                <!-- Pickup Store Badge -->
                                <Border Grid.Column="0"
                                        BackgroundColor="#F1F5F9"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8"
                                        WidthRequest="36"
                                        HeightRequest="36">
                                    <Label Text="🏪"
                                           FontSize="18"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>

                                <Label Grid.Column="1"
                                       Text="Pickup"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"
                                       VerticalOptions="Center" />

                                <!-- Unchecked Box -->
                                <Border Grid.Column="2"
                                        x:Name="PickupCheckBorder"
                                        BackgroundColor="{StaticResource CardBg}"
                                        StrokeThickness="1.5"
                                        Stroke="{StaticResource CardBorder}"
                                        StrokeShape="RoundRectangle 6"
                                        WidthRequest="22"
                                        HeightRequest="22">
                                    <Label x:Name="PickupCheckMark"
                                           Text=""
                                           FontSize="12"
                                           TextColor="{StaticResource BrandGreen}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- ── Payment Method Selector Card ── -->
                <Border BackgroundColor="{StaticResource CardBg}"
                        StrokeThickness="1"
                        Stroke="{StaticResource CardBorder}"
                        StrokeShape="RoundRectangle 16"
                        Padding="14,12">
                    <Border.Shadow>
                        <Shadow Brush="#10000000" Offset="0,2" Radius="6" Opacity="0.5" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Payment Method"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />

                        <!-- Credit Card Option (Visa) -->
                        <Border x:Name="CreditCardBorder"
                                BackgroundColor="#F8FAFC"
                                StrokeThickness="1.5"
                                Stroke="{StaticResource BrandGreen}"
                                StrokeShape="RoundRectangle 12"
                                Padding="12,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCreditCardSelected" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                <!-- Card Icon -->
                                <Border Grid.Column="0"
                                        BackgroundColor="#EFF6FF"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8"
                                        WidthRequest="36"
                                        HeightRequest="36">
                                    <Label Text="💳"
                                           FontSize="18"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>

                                <Label Grid.Column="1"
                                       Text="Credit Card"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"
                                       VerticalOptions="Center" />

                                <!-- Visa Badge -->
                                <Border Grid.Column="2"
                                        BackgroundColor="#1A1F71"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 4"
                                        Padding="6,2"
                                        VerticalOptions="Center">
                                    <Label Text="VISA"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextWhite}" />
                                </Border>

                                <!-- Checked Box -->
                                <Border Grid.Column="3"
                                        x:Name="CreditCardCheckBorder"
                                        BackgroundColor="{StaticResource BrandGreen}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 6"
                                        WidthRequest="22"
                                        HeightRequest="22">
                                    <Label x:Name="CreditCardCheckMark"
                                           Text="✓"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextWhite}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Digital Wallet Option -->
                        <Border x:Name="WalletBorder"
                                BackgroundColor="#F8FAFC"
                                StrokeThickness="1"
                                Stroke="{StaticResource CardBorder}"
                                StrokeShape="RoundRectangle 12"
                                Padding="12,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnWalletSelected" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                <!-- Wallet Icon -->
                                <Border Grid.Column="0"
                                        BackgroundColor="#F1F5F9"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8"
                                        WidthRequest="36"
                                        HeightRequest="36">
                                    <Label Text="📱"
                                           FontSize="18"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>

                                <Label Grid.Column="1"
                                       Text="Digital Wallet"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"
                                       VerticalOptions="Center" />

                                <!-- Unchecked Box -->
                                <Border Grid.Column="2"
                                        x:Name="WalletCheckBorder"
                                        BackgroundColor="{StaticResource CardBg}"
                                        StrokeThickness="1.5"
                                        Stroke="{StaticResource CardBorder}"
                                        StrokeShape="RoundRectangle 6"
                                        WidthRequest="22"
                                        HeightRequest="22">
                                    <Label x:Name="WalletCheckMark"
                                           Text=""
                                           FontSize="12"
                                           TextColor="{StaticResource BrandGreen}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- ── Order Summary Card with Promo Input ── -->
                <Border BackgroundColor="{StaticResource CardBg}"
                        StrokeThickness="1"
                        Stroke="{StaticResource CardBorder}"
                        StrokeShape="RoundRectangle 16"
                        Padding="14,14">
                    <Border.Shadow>
                        <Shadow Brush="#10000000" Offset="0,2" Radius="6" Opacity="0.5" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="Order Summary"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   x:Name="SummaryTotalLabel"
                                   Text="$13.08"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <!-- Promo Code Input + Green Apply Button -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Border Grid.Column="0"
                                    BackgroundColor="#F8FAFC"
                                    StrokeThickness="1"
                                    Stroke="{StaticResource CardBorder}"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="10,0"
                                    HeightRequest="42">
                                <Entry x:Name="CheckoutPromoEntry"
                                       Placeholder="Enter promo code"
                                       PlaceholderColor="{StaticResource TextMuted}"
                                       FontSize="12"
                                       TextColor="{StaticResource TextPrimary}"
                                       BackgroundColor="Transparent"
                                       VerticalOptions="Center" />
                            </Border>

                            <Button Grid.Column="1"
                                    Text="Apply"
                                    BackgroundColor="{StaticResource BrandGreen}"
                                    TextColor="{StaticResource TextWhite}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    CornerRadius="10"
                                    HeightRequest="42"
                                    Padding="16,0"
                                    Clicked="OnApplyPromoClicked" />
                        </Grid>

                        <Label x:Name="PromoFeedbackLabel"
                               Text=""
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{StaticResource StatusGreen}"
                               IsVisible="False" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ══ 3 · BOTTOM FIXED PLACE ORDER BUTTON ═════════════ -->
        <Border Grid.Row="2"
                BackgroundColor="{StaticResource CardBg}"
                StrokeThickness="1"
                Stroke="{StaticResource CardBorder}"
                StrokeShape="RoundRectangle 20,20,0,0"
                Padding="16,12,16,16">
            <Border.Shadow>
                <Shadow Brush="#1A000000" Offset="0,-4" Radius="12" Opacity="0.5" />
            </Border.Shadow>

            <Button x:Name="PlaceOrderButton"
                    Text="Place Order"
                    Style="{StaticResource BtnPrimary}"
                    HeightRequest="50"
                    CornerRadius="16"
                    Clicked="OnPlaceOrderClicked" />
        </Border>

    </Grid>
</ContentPage>
