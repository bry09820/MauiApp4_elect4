<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp4_elect4.Views.CartPage"
             xmlns:sys="clr-namespace:System;assembly=netstandard"
             Title="My Cart"
             BackgroundColor="{StaticResource PageBg}">

    <Grid RowDefinitions="*,Auto">

        <!-- ══ SCROLLABLE CONTENT ════════════════════════════════ -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16,14" Spacing="14">

                <!-- ── Service Area Notice Banner (Dark Amber Glass) ── -->
                <Border BackgroundColor="{StaticResource AccentAmberLight}"
                        StrokeThickness="1"
                        Stroke="{StaticResource AccentAmber}"
                        StrokeShape="RoundRectangle 16"
                        Padding="14,10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Grid.Column="0"
                               Text="⚡"
                               FontSize="18"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="Express Delivery: Guaranteed hot &amp; fresh delivery within 20-30 minutes in your local area."
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource AccentAmber}"
                               LineBreakMode="WordWrap"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- ── Section Heading ── -->
                <Label Text="Your Cart Items"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"
                       Margin="2,2,0,0" />

                <!-- ── Cart Items CollectionView ── -->
                <CollectionView x:Name="CartCollectionView"
                                SelectionMode="None"
                                ItemSizingStrategy="MeasureFirstItem">

                    <!-- Empty state -->
                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center"
                                             Padding="0,48"
                                             Spacing="12">
                            <Label Text="🛒"
                                   FontSize="72"
                                   HorizontalOptions="Center" />
                            <Label Text="Your cart is empty"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   HorizontalOptions="Center" />
                            <Label Text="Add dishes from the Catalog to taste perfection."
                                   FontSize="13"
                                   TextColor="{StaticResource TextSecondary}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                            <Button Text="Explore Menu →"
                                    Style="{StaticResource BtnGreen}"
                                    WidthRequest="220"
                                    HeightRequest="46"
                                    Margin="0,8,0,0"
                                    HorizontalOptions="Center"
                                    Clicked="OnBrowseProductsClicked" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <!-- ── Cart Item Card ── -->
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,5"
                                    BackgroundColor="{StaticResource CardBg}"
                                    StrokeThickness="1.2"
                                    Stroke="{StaticResource CardBorder}"
                                    StrokeShape="RoundRectangle 20"
                                    Padding="16">
                                <Border.Shadow>
                                    <Shadow Brush="#66000000" Offset="0,4" Radius="12" Opacity="0.35" />
                                </Border.Shadow>

                                <!-- Flat 3-row Grid layout for fast measure passes -->
                                <Grid ColumnDefinitions="*,Auto"
                                      RowDefinitions="Auto,Auto,Auto"
                                      RowSpacing="3">

                                    <!-- Row 0: Product Name -->
                                    <Label Grid.Column="0" Grid.Row="0"
                                           Text="{Binding Product.Name}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}"
                                           LineBreakMode="WordWrap" />

                                    <!-- Row 1: Serving Size -->
                                    <Label Grid.Column="0" Grid.Row="1"
                                           Text="1 serving · Chef Special"
                                           FontSize="11"
                                           TextColor="{StaticResource TextSecondary}" />

                                    <!-- Row 2: Unit Price -->
                                    <Label Grid.Column="0" Grid.Row="2"
                                           Text="{Binding Product.Price, StringFormat='${0:F2}'}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource BrandGreen}" />

                                    <!-- Col 1 (spans rows 0-2): Qty Adjuster (+ / count / -) -->
                                    <Grid Grid.Column="1" Grid.Row="0" Grid.RowSpan="3"
                                          RowDefinitions="Auto,Auto,Auto"
                                          RowSpacing="2"
                                          VerticalOptions="Center"
                                          HorizontalOptions="End">

                                        <Button Grid.Row="0"
                                                Text="＋"
                                                Style="{StaticResource BtnIconSmall}"
                                                BackgroundColor="{StaticResource BrandGreenLight}"
                                                TextColor="{StaticResource BrandGreen}"
                                                BorderColor="{StaticResource BrandGreen}"
                                                BorderWidth="1"
                                                CommandParameter="{Binding .}"
                                                Clicked="OnIncrementClicked" />

                                        <Label Grid.Row="1"
                                               Text="{Binding Quantity}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}"
                                               HorizontalOptions="Center"
                                               HorizontalTextAlignment="Center"
                                               WidthRequest="36" />

                                        <Button Grid.Row="2"
                                                Text="−"
                                                Style="{StaticResource BtnIconSmall}"
                                                BackgroundColor="{StaticResource CardBgElevated}"
                                                TextColor="{StaticResource TextPrimary}"
                                                BorderColor="{StaticResource CardBorder}"
                                                BorderWidth="1"
                                                CommandParameter="{Binding .}"
                                                Clicked="OnDecrementClicked" />
                                    </Grid>

                                    <!-- Row 3: Subtotal + Remove Button -->
                                    <Grid Grid.Column="0" Grid.Row="3"
                                          ColumnDefinitions="*,Auto"
                                          Margin="0,10,0,0">
                                        <Label Grid.Column="0"
                                               Text="{Binding Subtotal, StringFormat='Subtotal: ${0:F2}'}"
                                               FontSize="12"
                                               TextColor="{StaticResource TextSecondary}"
                                               VerticalOptions="Center" />
                                        <Button Grid.Column="1"
                                                Text="🗑"
                                                Style="{StaticResource BtnIconSmall}"
                                                BackgroundColor="{StaticResource AccentRedLight}"
                                                TextColor="{StaticResource AccentRed}"
                                                BorderColor="{StaticResource AccentRed}"
                                                BorderWidth="1"
                                                CommandParameter="{Binding .}"
                                                Clicked="OnRemoveClicked" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- ── Promo Code Card ── -->
                <Border BackgroundColor="{StaticResource CardBg}"
                        StrokeThickness="1.2"
                        Stroke="{StaticResource CardBorder}"
                        StrokeShape="RoundRectangle 20"
                        Padding="16"
                        Margin="0,2,0,0">
                    <Border.Shadow>
                        <Shadow Brush="#55000000" Offset="0,4" Radius="12" Opacity="0.30" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="🏷️  Promo &amp; Voucher Code"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Border Grid.Column="0" Style="{StaticResource InputBorder}" HeightRequest="44">
                                <Entry x:Name="PromoCodeEntry"
                                       Placeholder="Enter code (e.g. SAVE20)"
                                       PlaceholderColor="{StaticResource TextMuted}"
                                       FontSize="13"
                                       TextColor="{StaticResource TextPrimary}"
                                       BackgroundColor="Transparent" />
                            </Border>
                            <Button Grid.Column="1"
                                    x:Name="ApplyPromoButton"
                                    Text="Apply"
                                    BackgroundColor="{StaticResource BrandGreen}"
                                    TextColor="{StaticResource TextWhite}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    CornerRadius="14"
                                    HeightRequest="44"
                                    Padding="16,0"
                                    Clicked="OnApplyPromoClicked" />
                        </Grid>

                        <Label x:Name="PromoStatusLabel"
                               Text=""
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{StaticResource StatusGreen}"
                               IsVisible="False" />
                    </VerticalStackLayout>
                </Border>

                <!-- ── Delivery Scheduling Card ── -->
                <Border BackgroundColor="{StaticResource CardBg}"
                        StrokeThickness="1.2"
                        Stroke="{StaticResource CardBorder}"
                        StrokeShape="RoundRectangle 20"
                        Padding="18"
                        Margin="0,2,0,0">
                    <Border.Shadow>
                        <Shadow Brush="#55000000" Offset="0,4" Radius="12" Opacity="0.30" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">
                        <Label Text="📅  Schedule Delivery"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />

                        <BoxView HeightRequest="1" Color="{StaticResource CardBorder}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="Delivery Date"
                                   FontSize="13"
                                   TextColor="{StaticResource TextSecondary}"
                                   VerticalOptions="Center" />
                            <DatePicker x:Name="DeliveryDatePicker"
                                        Grid.Column="1"
                                        Format="ddd, MMM d yyyy"
                                        TextColor="{StaticResource BrandGreen}"
                                        FontAttributes="Bold"
                                        MinimumDate="{x:Static sys:DateTime.Today}"
                                        HorizontalOptions="End" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="Delivery Time"
                                   FontSize="13"
                                   TextColor="{StaticResource TextSecondary}"
                                   VerticalOptions="Center" />
                            <TimePicker x:Name="DeliveryTimePicker"
                                        Grid.Column="1"
                                        Format="hh:mm tt"
                                        TextColor="{StaticResource BrandGreen}"
                                        FontAttributes="Bold"
                                        HorizontalOptions="End" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ══ FLOATING SUMMARY + CHECKOUT CARD ════════════════ -->
        <Border Grid.Row="1"
                BackgroundColor="{StaticResource CardBg}"
                StrokeThickness="1.5"
                Stroke="{StaticResource CardBorder}"
                StrokeShape="RoundRectangle 24,24,0,0"
                Padding="20,18">
            <Border.Shadow>
                <Shadow Brush="#AA000000" Offset="0,-6" Radius="24" Opacity="0.50" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="8">

                <!-- Subtotal Row -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="Subtotal"
                           FontSize="13"
                           TextColor="{StaticResource TextSecondary}" />
                    <Label x:Name="SubtotalLabel"
                           Grid.Column="1"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />
                </Grid>

                <!-- Delivery Fee Row -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="Delivery Fee"
                           FontSize="13"
                           TextColor="{StaticResource TextSecondary}" />
                    <Label x:Name="DeliveryFeeLabel"
                           Grid.Column="1"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />
                </Grid>

                <!-- Discount Row -->
                <Grid x:Name="DiscountRow"
                      ColumnDefinitions="*,Auto"
                      IsVisible="False">
                    <Label Grid.Column="0"
                           Text="Promo Discount"
                           FontSize="13"
                           TextColor="{StaticResource StatusGreen}" />
                    <Label x:Name="DiscountLabel"
                           Grid.Column="1"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{StaticResource StatusGreen}" />
                </Grid>

                <BoxView HeightRequest="1" Color="{StaticResource CardBorder}" Margin="0,3" />

                <!-- Grand Total Row -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="Total"
                           FontSize="19"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />
                    <Label x:Name="TotalLabel"
                           Grid.Column="1"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{StaticResource BrandGreen}" />
                </Grid>

                <!-- Checkout CTA — Full Width Electric Coral Pill -->
                <Button x:Name="CheckoutButton"
                        Text="Proceed to Checkout  →"
                        Style="{StaticResource BtnPrimary}"
                        HeightRequest="52"
                        CornerRadius="26"
                        Margin="0,4,0,0"
                        Clicked="OnCheckoutClicked">
                    <Button.Shadow>
                        <Shadow Brush="#66FF6B4A" Offset="0,4" Radius="14" Opacity="0.45" />
                    </Button.Shadow>
                </Button>
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>
