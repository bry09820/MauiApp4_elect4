<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MauiApp4_elect4.Models"
             x:Class="MauiApp4_elect4.Views.CartPage"
             Title="My Cart"
             BackgroundColor="{StaticResource PageBg}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="True">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ══ 1 · FOREST GREEN TOP HEADER & CART BADGE ════════ -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource BrandGreen}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 0,0,24,24"
                Padding="16,14,16,16">
            <Border.Shadow>
                <Shadow Brush="#331E6B39" Offset="0,4" Radius="12" Opacity="0.5" />
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">

                <!-- Back Navigation Button -->
                <Border Grid.Column="0"
                        BackgroundColor="#2D7F4C"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        WidthRequest="40"
                        HeightRequest="40">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="←"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextWhite}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- Page Title: My Cart -->
                <Label Grid.Column="1"
                       Text="My Cart"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextWhite}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />

                <!-- Cart Icon with Live Counter Badge -->
                <Grid Grid.Column="2" WidthRequest="40" HeightRequest="40">
                    <Border BackgroundColor="#2D7F4C"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 20"
                            WidthRequest="40"
                            HeightRequest="40">
                        <Label Text="🛒"
                               FontSize="16"
                               TextColor="{StaticResource TextWhite}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <!-- Active Badge Circle -->
                    <Border x:Name="CartCountBadge"
                            IsVisible="{Binding HasItems}"
                            BackgroundColor="{StaticResource StatusGreen}"
                            StrokeThickness="1.5"
                            Stroke="{StaticResource TextWhite}"
                            StrokeShape="RoundRectangle 9"
                            WidthRequest="18"
                            HeightRequest="18"
                            HorizontalOptions="End"
                            VerticalOptions="Start"
                            Margin="0,-2,-2,0">
                        <Label x:Name="CartCountBadgeLabel"
                               Text="{Binding CartCountBadgeText}"
                               FontSize="9"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextWhite}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- ══ 2 · SCROLLABLE CART ITEMS & SUMMARY ═════════════ -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,14,16,18" Spacing="14">

                <!-- ── Cart Items CollectionView ── -->
                <CollectionView x:Name="CartCollectionView"
                                ItemsSource="{Binding CartItems}"
                                SelectionMode="None">

                    <!-- Empty State -->
                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center"
                                             Padding="0,48"
                                             Spacing="12">
                            <Label Text="🛒"
                                   FontSize="64"
                                   HorizontalOptions="Center" />
                            <Label Text="Your Cart is Empty"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   HorizontalOptions="Center" />
                            <Label Text="Explore fresh groceries and produce to fill your basket."
                                   FontSize="13"
                                   TextColor="{StaticResource TextSecondary}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                            <Button Text="Explore Shops"
                                    Style="{StaticResource BtnGreen}"
                                    WidthRequest="180"
                                    HeightRequest="44"
                                    Margin="0,8,0,0"
                                    HorizontalOptions="Center"
                                    Clicked="OnExploreShopsClicked" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <!-- Cart Item Card matching Reference UI -->
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:CartItem">
                            <Border Margin="0,0,0,12"
                                    BackgroundColor="{StaticResource CardBg}"
                                    StrokeThickness="1"
                                    Stroke="{StaticResource CardBorder}"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="12">
                                <Border.Shadow>
                                    <Shadow Brush="#10000000" Offset="0,2" Radius="8" Opacity="0.6" />
                                </Border.Shadow>

                                <Grid ColumnDefinitions="72,*,Auto" ColumnSpacing="12" VerticalOptions="Center">

                                    <!-- 1 · Product Thumbnail -->
                                    <Border Grid.Column="0"
                                            BackgroundColor="#F8FAFC"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 12"
                                            WidthRequest="72"
                                            HeightRequest="72"
                                            Padding="0">
                                        <Image Source="{Binding Product.ImageUrl}"
                                               Aspect="AspectFill"
                                               WidthRequest="72"
                                               HeightRequest="72" />
                                    </Border>

                                    <!-- 2 · Title & Weight Badge -->
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                        <Label Text="{Binding Product.Name}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}"
                                               MaxLines="1"
                                               LineBreakMode="TailTruncation" />

                                        <!-- Weight Badge with checkmark / icon -->
                                        <Border BackgroundColor="#F1F5F9"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 6"
                                                Padding="6,3"
                                                HorizontalOptions="Start">
                                            <HorizontalStackLayout Spacing="4">
                                                <Label Text="✓"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource BrandGreen}"
                                                       VerticalOptions="Center" />
                                                <Label Text="{Binding Product.Weight}"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource TextSecondary}"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Border>

                                        <!-- Substitution Rule Selector Pill -->
                                        <Border BackgroundColor="#EBF6EE"
                                                StrokeThickness="1"
                                                Stroke="#C8E6D0"
                                                StrokeShape="RoundRectangle 6"
                                                Padding="6,3"
                                                HorizontalOptions="Start">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnSubstitutionPreferenceTapped" CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <HorizontalStackLayout Spacing="3" VerticalOptions="Center">
                                                <Label Text="{Binding SubstitutionBadgeText}"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource BrandGreen}"
                                                       VerticalOptions="Center" />
                                                <Label Text="▾"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource BrandGreen}"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </VerticalStackLayout>

                                    <!-- 3 · Unit Price & Quantity Stepper -->
                                    <VerticalStackLayout Grid.Column="2"
                                                         VerticalOptions="Center"
                                                         HorizontalOptions="End"
                                                         Spacing="6">

                                        <!-- Dynamic Formatted Subtotal -->
                                        <Label Text="{Binding FormattedSubtotal}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}"
                                               HorizontalOptions="End" />

                                        <!-- Custom Stepper [ - 1 + ] -->
                                        <Border BackgroundColor="#F1F5F9"
                                                StrokeThickness="1"
                                                Stroke="{StaticResource CardBorder}"
                                                StrokeShape="RoundRectangle 10"
                                                Padding="2"
                                                HeightRequest="32">
                                            <Grid ColumnDefinitions="28,30,28" VerticalOptions="Center">
                                                <!-- Decrement Button -->
                                                <Label Grid.Column="0"
                                                       Text="−"
                                                       FontSize="16"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource TextPrimary}"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnDecrementTapped" CommandParameter="{Binding .}" />
                                                    </Label.GestureRecognizers>
                                                </Label>

                                                <!-- Current Quantity Display -->
                                                <Label Grid.Column="1"
                                                       Text="{Binding Quantity}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource TextPrimary}"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />

                                                <!-- Increment Button -->
                                                <Label Grid.Column="2"
                                                       Text="+"
                                                       FontSize="16"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource BrandGreen}"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnIncrementTapped" CommandParameter="{Binding .}" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                            </Grid>
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- ── Promo Code Card ── -->
                <Border BackgroundColor="{StaticResource CardBg}"
                        StrokeThickness="1"
                        Stroke="{StaticResource CardBorder}"
                        StrokeShape="RoundRectangle 14"
                        Padding="12,4"
                        HeightRequest="48">
                    <Border.Shadow>
                        <Shadow Brush="#0C000000" Offset="0,2" Radius="6" Opacity="0.5" />
                    </Border.Shadow>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                        <Label Grid.Column="0"
                               Text="🎟️"
                               FontSize="16"
                               VerticalOptions="Center" />
                        <Entry x:Name="PromoCodeEntry"
                               Text="{Binding PromoCodeInput, Mode=TwoWay}"
                               Grid.Column="1"
                               Placeholder="Enter promo code (e.g. FRESH20)"
                               PlaceholderColor="{StaticResource TextMuted}"
                               FontSize="13"
                               TextColor="{StaticResource TextPrimary}"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center" />
                        <Button Grid.Column="2"
                                Text="Apply"
                                BackgroundColor="{StaticResource BrandGreenLight}"
                                TextColor="{StaticResource BrandGreen}"
                                FontAttributes="Bold"
                                FontSize="12"
                                CornerRadius="8"
                                HeightRequest="32"
                                Padding="12,0"
                                Clicked="OnApplyPromoClicked" />
                    </Grid>
                </Border>

                <!-- ── Cost Breakdown Summary Card ── -->
                <Border BackgroundColor="{StaticResource CardBg}"
                        StrokeThickness="1"
                        Stroke="{StaticResource CardBorder}"
                        StrokeShape="RoundRectangle 16"
                        Padding="16,14">
                    <Border.Shadow>
                        <Shadow Brush="#10000000" Offset="0,2" Radius="8" Opacity="0.5" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">

                        <!-- Subtotal Row -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="Subtotal"
                                   FontSize="14"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Label x:Name="SubtotalLabel"
                                   Grid.Column="1"
                                   Text="{Binding FormattedSubtotal}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                        </Grid>

                        <!-- Delivery Fee Row -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="Delivery Fee"
                                   FontSize="14"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Label x:Name="DeliveryFeeLabel"
                                   Grid.Column="1"
                                   Text="{Binding FormattedDeliveryFee}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                        </Grid>

                        <!-- Discount Row (Visible when promo applied) -->
                        <Grid x:Name="DiscountRow"
                              ColumnDefinitions="*,Auto"
                              IsVisible="{Binding HasDiscount}">
                            <Label Grid.Column="0"
                                   Text="Discount"
                                   FontSize="14"
                                   TextColor="{StaticResource BrandGreen}" />
                            <Label x:Name="DiscountLabel"
                                   Grid.Column="1"
                                   Text="{Binding FormattedDiscount}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource BrandGreen}" />
                        </Grid>

                        <!-- Divider Line -->
                        <BoxView HeightRequest="1"
                                 Color="{StaticResource CardBorder}"
                                 Margin="0,2" />

                        <!-- Total Row -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="Total"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center" />
                            <Label x:Name="TotalLabel"
                                   Grid.Column="1"
                                   Text="{Binding FormattedTotal}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ══ 3 · FIXED BOTTOM PROCEED TO CHECKOUT ACTION ═════ -->
        <Border Grid.Row="2"
                BackgroundColor="{StaticResource CardBg}"
                StrokeThickness="1"
                Stroke="{StaticResource CardBorder}"
                StrokeShape="RoundRectangle 20,20,0,0"
                Padding="16,12,16,16">
            <Border.Shadow>
                <Shadow Brush="#1A000000" Offset="0,-4" Radius="12" Opacity="0.5" />
            </Border.Shadow>

            <Button x:Name="ProceedToCheckoutButton"
                    Text="{Binding CheckoutButtonText}"
                    IsEnabled="{Binding HasItems}"
                    BackgroundColor="{StaticResource BrandGreen}"
                    TextColor="{StaticResource TextWhite}"
                    FontSize="15"
                    FontAttributes="Bold"
                    CornerRadius="16"
                    HeightRequest="52"
                    HorizontalOptions="Fill"
                    Clicked="OnProceedToCheckoutClicked">
                <Button.Shadow>
                    <Shadow Brush="#4D1E6B39" Offset="0,4" Radius="14" Opacity="0.4" />
                </Button.Shadow>
            </Button>
        </Border>

    </Grid>
</ContentPage>
