<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MauiApp4_elect4.Models"
             x:Class="MauiApp4_elect4.Views.OrdersPage"
             Title="Orders"
             BackgroundColor="{StaticResource PageBg}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="True">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ══ 1 · FOREST GREEN TOP HEADER & SEARCH ════════════ -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource BrandGreen}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 0,0,24,24"
                Padding="16,14,16,16">
            <Border.Shadow>
                <Shadow Brush="#331E6B39" Offset="0,4" Radius="12" Opacity="0.5" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="12">
                <!-- Top Row: Back Button & Title -->
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                    <Border Grid.Column="0"
                            BackgroundColor="#2D7F4C"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 20"
                            WidthRequest="40"
                            HeightRequest="40">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="←"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextWhite}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <Label Grid.Column="1"
                           Text="Orders"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextWhite}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

                    <BoxView Grid.Column="2" WidthRequest="40" Color="Transparent" />
                </Grid>

                <!-- Search Orders Capsule Input -->
                <Border BackgroundColor="{StaticResource CardBg}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 22"
                        Padding="14,0"
                        HeightRequest="44">
                    <Border.Shadow>
                        <Shadow Brush="#1A000000" Offset="0,2" Radius="6" Opacity="0.4" />
                    </Border.Shadow>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0"
                               Text="🔍"
                               FontSize="14"
                               TextColor="{StaticResource TextSecondary}"
                               VerticalOptions="Center" />
                        <Entry x:Name="SearchOrdersEntry"
                               Text="{Binding SearchText, Mode=TwoWay}"
                               Grid.Column="1"
                               Placeholder="Search Orders..."
                               PlaceholderColor="{StaticResource TextMuted}"
                               FontSize="13"
                               TextColor="{StaticResource TextPrimary}"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center"
                               TextChanged="OnSearchTextChanged" />
                        <!-- Mic / Filter Icon -->
                        <Border Grid.Column="2"
                                BackgroundColor="{StaticResource BrandGreenLight}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                WidthRequest="26"
                                HeightRequest="26">
                            <Label Text="🎙️"
                                   FontSize="12"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </Border>

        <!-- ══ 2 · HORIZONTAL TAB BAR (Ongoing, Past, Cancelled) ═ -->
        <Border Grid.Row="1"
                BackgroundColor="{StaticResource CardBg}"
                StrokeThickness="1"
                Stroke="{StaticResource CardBorder}"
                StrokeShape="RoundRectangle 14"
                Margin="16,12,16,6"
                Padding="4"
                HeightRequest="46">
            <Grid ColumnDefinitions="*,*,*">
                <!-- Tab 1: Ongoing (Active) -->
                <Button Grid.Column="0"
                        x:Name="TabOngoing"
                        Text="Ongoing"
                        BackgroundColor="{StaticResource BrandGreen}"
                        TextColor="{StaticResource TextWhite}"
                        FontAttributes="Bold"
                        FontSize="12"
                        CornerRadius="10"
                        Padding="0"
                        HeightRequest="38"
                        Clicked="OnTabOngoingClicked" />

                <!-- Tab 2: Past -->
                <Button Grid.Column="1"
                        x:Name="TabPast"
                        Text="Past"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource TextSecondary}"
                        FontSize="12"
                        CornerRadius="10"
                        Padding="0"
                        HeightRequest="38"
                        Clicked="OnTabPastClicked" />

                <!-- Tab 3: Cancelled -->
                <Button Grid.Column="2"
                        x:Name="TabCancelled"
                        Text="Cancelled"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource TextSecondary}"
                        FontSize="12"
                        CornerRadius="10"
                        Padding="0"
                        HeightRequest="38"
                        Clicked="OnTabCancelledClicked" />
            </Grid>
        </Border>

        <!-- ══ 3 · SCROLLABLE ORDER CARDS LIST ═════════════════ -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="16,6,16,20" Spacing="12">

                <!-- ── Floating Active Order Tracking Banner ── -->
                <Border IsVisible="{Binding HasActiveOrder}"
                        BackgroundColor="#EBF6EE"
                        StrokeThickness="1.5"
                        Stroke="{StaticResource BrandGreen}"
                        StrokeShape="RoundRectangle 16"
                        Padding="14,12"
                        Margin="0,0,0,4">
                    <Border.Shadow>
                        <Shadow Brush="#261E6B39" Offset="0,3" Radius="8" Opacity="0.5" />
                    </Border.Shadow>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                        <!-- Icon Circle -->
                        <Border Grid.Column="0"
                                BackgroundColor="{StaticResource BrandGreen}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 20"
                                WidthRequest="40"
                                HeightRequest="40">
                            <Label Text="🚚"
                                   FontSize="18"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <!-- Order Info & ETA -->
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Active Order In Progress"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource BrandGreen}" />
                            <Label Text="{Binding ActiveOrder.DeliveryStatusText, StringFormat='Status: {0}'}"
                                   FontSize="11"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Label Text="{Binding ActiveOrder.OrderNumberDisplay}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                        </VerticalStackLayout>

                        <!-- Track Live Button -->
                        <Button Grid.Column="2"
                                Text="Track Live →"
                                BackgroundColor="{StaticResource BrandGreen}"
                                TextColor="{StaticResource TextWhite}"
                                FontSize="12"
                                FontAttributes="Bold"
                                CornerRadius="12"
                                HeightRequest="36"
                                Padding="14,0"
                                Clicked="OnActiveOrderBannerClicked" />
                    </Grid>
                </Border>

                <CollectionView x:Name="OrdersCollectionView"
                                ItemsSource="{Binding Orders}"
                                SelectionMode="None">

                    <!-- Empty State -->
                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center"
                                             Padding="0,48"
                                             Spacing="10">
                            <Label Text="📦" FontSize="56" HorizontalOptions="Center" />
                            <Label Text="No Orders Found"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   HorizontalOptions="Center" />
                            <Label Text="Orders in this category will appear here."
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <!-- Order Card ItemTemplate matching Reference UI -->
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Order">
                            <Border Margin="0,0,0,12"
                                    BackgroundColor="{StaticResource CardBg}"
                                    StrokeThickness="1"
                                    Stroke="{StaticResource CardBorder}"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="14,12">
                                <Border.Shadow>
                                    <Shadow Brush="#10000000" Offset="0,2" Radius="8" Opacity="0.5" />
                                </Border.Shadow>

                                <VerticalStackLayout Spacing="8">
                                    <!-- Row 1: Vendor Name & Status Badge -->
                                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                        <!-- Left: Vendor Icon & Name -->
                                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                            <Border BackgroundColor="{StaticResource BrandGreenLight}"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 8"
                                                    WidthRequest="32"
                                                    HeightRequest="32">
                                                <Label Text="{Binding VendorIcon}"
                                                       FontSize="16"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>
                                            <Label Text="{Binding VendorName}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource TextPrimary}"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>

                                        <!-- Right: Status Badge -->
                                        <Label Text="{Binding DeliveryStatusText}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource BrandGreen}"
                                               VerticalOptions="Center" />
                                    </Grid>

                                    <!-- Row 2: Order ID and Total Amount -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0"
                                               Text="{Binding OrderNumberDisplay}"
                                               FontSize="12"
                                               TextColor="{StaticResource TextSecondary}" />
                                        <Label Grid.Column="1"
                                               Text="{Binding TotalAmount, StringFormat='${0:F2}'}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}" />
                                    </Grid>

                                    <!-- Row 3: Items Preview & Action Button -->
                                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Line1Preview}"
                                                   FontSize="12"
                                                   TextColor="{StaticResource TextPrimary}"
                                                   MaxLines="1"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Line2Preview}"
                                                   FontSize="12"
                                                   TextColor="{StaticResource TextSecondary}"
                                                   MaxLines="1"
                                                   LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>

                                        <!-- Action Button: Track / View Details -->
                                        <Button Grid.Column="1"
                                                Text="{Binding ActionButtonText}"
                                                BackgroundColor="{StaticResource BrandGreen}"
                                                TextColor="{StaticResource TextWhite}"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                CornerRadius="10"
                                                HeightRequest="34"
                                                Padding="16,0"
                                                CommandParameter="{Binding .}"
                                                Clicked="OnOrderActionClicked" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
