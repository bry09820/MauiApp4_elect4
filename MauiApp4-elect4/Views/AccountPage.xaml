<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp4_elect4.Views.AccountPage"
             Title="Account"
             BackgroundColor="{StaticResource PageBg}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="True">

    <Grid RowDefinitions="Auto,*">

        <!-- ══ 1 · FOREST GREEN TOP HEADER ═════════════════════ -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource BrandGreen}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 0,0,24,24"
                Padding="16,14,16,16">
            <Border.Shadow>
                <Shadow Brush="#331E6B39" Offset="0,4" Radius="12" Opacity="0.5" />
            </Border.Shadow>

            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <!-- Title -->
                <Label Grid.Column="0"
                       Text="Account"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextWhite}"
                       VerticalOptions="Center" />

                <!-- Header Edit Button -->
                <Border Grid.Column="1"
                        BackgroundColor="#2D7F4C"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="12,6"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEditProfileTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="Edit"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextWhite}" />
                </Border>
            </Grid>
        </Border>

        <!-- ══ 2 · SCROLLABLE CONTENT BODY ═════════════════════ -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,14,16,28" Spacing="14">

                <!-- ── Profile Header Section Card ── -->
                <Border BackgroundColor="{StaticResource CardBg}"
                        StrokeThickness="1"
                        Stroke="{StaticResource CardBorder}"
                        StrokeShape="RoundRectangle 16"
                        Padding="14,12">
                    <Border.Shadow>
                        <Shadow Brush="#10000000" Offset="0,2" Radius="6" Opacity="0.5" />
                    </Border.Shadow>

                    <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="12" VerticalOptions="Center">

                        <!-- Avatar Photo -->
                        <Border Grid.Column="0"
                                StrokeThickness="1.5"
                                Stroke="{StaticResource BrandGreen}"
                                StrokeShape="RoundRectangle 24"
                                WidthRequest="48"
                                HeightRequest="48"
                                Padding="0">
                            <Image Source="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=300&amp;auto=format&amp;fit=crop&amp;q=80"
                                   Aspect="AspectFill"
                                   WidthRequest="48"
                                   HeightRequest="48">
                                <Image.Clip>
                                    <RoundRectangleGeometry CornerRadius="24" Rect="0,0,48,48" />
                                </Image.Clip>
                            </Image>
                        </Border>

                        <!-- User Info (Dynamically bound) -->
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label x:Name="UserNameLabel"
                                   Text="{Binding FullName}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Label x:Name="UserEmailLabel"
                                   Text="{Binding Email}"
                                   FontSize="11"
                                   TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>

                        <!-- Edit Pill Button -->
                        <Border Grid.Column="2"
                                BackgroundColor="#F1F5F9"
                                StrokeThickness="1"
                                Stroke="{StaticResource CardBorder}"
                                StrokeShape="RoundRectangle 10"
                                Padding="12,6"
                                VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEditProfileTapped" />
                            </Border.GestureRecognizers>
                            <Label Text="Edit"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- ── Delivery Location & GPS Geocoding Card ── -->
                <Border BackgroundColor="{StaticResource CardBg}"
                        StrokeThickness="1"
                        Stroke="{StaticResource CardBorder}"
                        StrokeShape="RoundRectangle 16"
                        Padding="14,12">
                    <Border.Shadow>
                        <Shadow Brush="#10000000" Offset="0,2" Radius="6" Opacity="0.5" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                            <Border Grid.Column="0"
                                    BackgroundColor="#EFF6FF"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    WidthRequest="32"
                                    HeightRequest="32">
                                <Label Text="📍" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1"
                                   Text="Saved Delivery Location"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center" />

                            <!-- GPS Coordinates Pill -->
                            <Border Grid.Column="2"
                                    BackgroundColor="#E8F5E9"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="6,3">
                                <Label Text="{Binding FormattedCoordinates}"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource BrandGreen}"
                                       VerticalOptions="Center" />
                            </Border>
                        </Grid>

                        <Label Text="{Binding DefaultAddress}"
                               FontSize="12"
                               TextColor="{StaticResource TextSecondary}"
                               LineBreakMode="WordWrap" />

                        <!-- Status or Geocoding Indicator -->
                        <Label Text="{Binding LocationStatusMessage}"
                               FontSize="10"
                               TextColor="{StaticResource BrandGreen}"
                               FontAttributes="Italic"
                               IsVisible="{Binding LocationStatusMessage, Converter={x:Null}}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,4,0,0">
                            <!-- Change Address Button -->
                            <Border Grid.Column="0"
                                    BackgroundColor="#F1F5F9"
                                    StrokeThickness="1"
                                    Stroke="{StaticResource CardBorder}"
                                    StrokeShape="RoundRectangle 10"
                                    HeightRequest="36">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnDeliveryAddressTapped" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="✏️" FontSize="11" VerticalOptions="Center" />
                                    <Label Text="Edit Address" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>

                            <!-- Detect GPS Button -->
                            <Border Grid.Column="1"
                                    BackgroundColor="{StaticResource BrandGreen}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    HeightRequest="36">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding UseCurrentLocationCommand}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="🎯" FontSize="11" VerticalOptions="Center" />
                                    <Label Text="Use GPS" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextWhite}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ── Navigation Menu Options Card ── -->
                <Border BackgroundColor="{StaticResource CardBg}"
                        StrokeThickness="1"
                        Stroke="{StaticResource CardBorder}"
                        StrokeShape="RoundRectangle 16"
                        Padding="14,4">
                    <Border.Shadow>
                        <Shadow Brush="#10000000" Offset="0,2" Radius="6" Opacity="0.5" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="0">

                        <!-- 1 · My Orders -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMyOrdersTapped" />
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" BackgroundColor="#EBF6EE" StrokeThickness="0" StrokeShape="RoundRectangle 8" WidthRequest="32" HeightRequest="32">
                                <Label Text="📦" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="My Orders" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="&gt;" FontSize="16" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource CardBorder}" />

                        <!-- 2 · Delivery Address -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDeliveryAddressTapped" />
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" BackgroundColor="#EFF6FF" StrokeThickness="0" StrokeShape="RoundRectangle 8" WidthRequest="32" HeightRequest="32">
                                <Label Text="📍" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="Delivery Address" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="&gt;" FontSize="16" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource CardBorder}" />

                        <!-- 3 · Payment Methods -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPaymentMethodsTapped" />
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" BackgroundColor="#FEF3C7" StrokeThickness="0" StrokeShape="RoundRectangle 8" WidthRequest="32" HeightRequest="32">
                                <Label Text="💳" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="Payment Methods" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="&gt;" FontSize="16" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource CardBorder}" />

                        <!-- 4 · Manage Vendors (Admin shortcut) -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnManageVendorsTapped" />
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" BackgroundColor="#EBF6EE" StrokeThickness="0" StrokeShape="RoundRectangle 8" WidthRequest="32" HeightRequest="32">
                                <Label Text="🏪" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="Manage Vendors" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="&gt;" FontSize="16" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource CardBorder}" />

                        <!-- 5 · Promotions -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPromotionsTapped" />
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" BackgroundColor="#FEE2E2" StrokeThickness="0" StrokeShape="RoundRectangle 8" WidthRequest="32" HeightRequest="32">
                                <Label Text="🎁" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="Promotions" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="&gt;" FontSize="16" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource CardBorder}" />

                        <!-- 6 · Support & Help -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSupportHelpTapped" />
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" BackgroundColor="#EFF6FF" StrokeThickness="0" StrokeShape="RoundRectangle 8" WidthRequest="32" HeightRequest="32">
                                <Label Text="🎧" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="Support &amp; Help" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="&gt;" FontSize="16" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource CardBorder}" />

                        <!-- 7 · Settings -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSettingsTapped" />
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" BackgroundColor="#F1F5F9" StrokeThickness="0" StrokeShape="RoundRectangle 8" WidthRequest="32" HeightRequest="32">
                                <Label Text="⚙️" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="Settings" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="&gt;" FontSize="16" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- ── Log Out Button ── -->
                <Button Text="Log Out"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource AccentRed}"
                        FontAttributes="Bold"
                        FontSize="15"
                        HeightRequest="44"
                        Margin="0,4,0,0"
                        HorizontalOptions="Center"
                        Clicked="OnLogoutClicked" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
