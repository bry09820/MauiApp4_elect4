<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiApp4_elect4.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiApp4_elect4"
    xmlns:views="clr-namespace:MauiApp4_elect4.Views"
    Title="FreshMart"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="True"
    Shell.TabBarBackgroundColor="#FFFFFF"
    Shell.TabBarForegroundColor="#1E6B39"
    Shell.TabBarUnselectedColor="#8E8E93"
    Shell.TabBarTitleColor="#1E6B39">

    <!-- ═══════════════════════════════════════════════════════════
         CUSTOMER BOTTOM NAVIGATION TAB BAR
         Forest Green Theme (#1E6B39) · Neutral Grey (#8E8E93)
         1 · Home       (ExploreShopsPage)
         2 · Categories (GreenMarketPage)
         3 · Cart       (MyCartPage)
         4 · Orders     (OrdersPage)
         5 · Profile    (AccountPage)
         ═══════════════════════════════════════════════════════════ -->
    <TabBar>

        <!-- 1 · Home ───────────────────────────────────────────── -->
        <ShellContent
            Title="Home"
            Icon="tab_home.png"
            ContentTemplate="{DataTemplate views:ExploreShopsPage}"
            Route="ExploreShopsPage" />

        <!-- 2 · Categories ─────────────────────────────────────── -->
        <ShellContent
            Title="Categories"
            Icon="tab_categories.png"
            ContentTemplate="{DataTemplate views:GreenMarketPage}"
            Route="GreenMarketPage" />

        <!-- 3 · Cart ───────────────────────────────────────────── -->
        <ShellContent
            Title="Cart"
            Icon="tab_cart.png"
            ContentTemplate="{DataTemplate views:MyCartPage}"
            Route="MyCartPage" />

        <!-- 4 · Orders ─────────────────────────────────────────── -->
        <ShellContent
            Title="Orders"
            Icon="tab_orders.png"
            ContentTemplate="{DataTemplate views:OrdersPage}"
            Route="OrdersPage" />

        <!-- 5 · Profile ────────────────────────────────────────── -->
        <ShellContent
            Title="Profile"
            Icon="tab_profile.png"
            ContentTemplate="{DataTemplate views:AccountPage}"
            Route="AccountPage" />

    </TabBar>

</Shell>


