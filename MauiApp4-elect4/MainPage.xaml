<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp4_elect4.MainPage"
             Title="Catalog"
             BackgroundColor="{StaticResource PageBg}">

    <!-- ═══════════════════════════════════════════════════════
         ROOT GRID — sticky header / search / categories / grid
         ═══════════════════════════════════════════════════════ -->
    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- ══ SLEEK DARK HEADER ═════════════════════════════════ -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              BackgroundColor="{StaticResource PageBg}"
              Padding="18,16,18,10">

            <!-- Left: store name + delivery location (Interactive) -->
            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                <HorizontalStackLayout Spacing="4">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLocationTapped" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="📍" FontSize="11" VerticalOptions="Center" />
                    <Label Text="Deliver to"
                           FontSize="11"
                           TextColor="{StaticResource TextSecondary}" />
                    <Label x:Name="CurrentLocationLabel"
                           Text="Current Location ▾"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{StaticResource BrandGreen}" />
                </HorizontalStackLayout>
                <Label Text="FreshMart 🍽️"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}" />
            </VerticalStackLayout>

            <!-- Right: notification bell + cart badge -->
            <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                <!-- Bell icon with subtle border (Interactive) -->
                <Border x:Name="NotificationBellBorder"
                        BackgroundColor="{StaticResource CardBgElevated}"
                        StrokeThickness="1"
                        Stroke="{StaticResource CardBorder}"
                        StrokeShape="RoundRectangle 20"
                        Padding="10,8"
                        WidthRequest="42"
                        HeightRequest="42">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNotificationBellTapped" />
                    </Border.GestureRecognizers>
                    <Border.Shadow>
                        <Shadow Brush="#40000000" Offset="0,2" Radius="6" Opacity="0.3" />
                    </Border.Shadow>
                    <Label Text="🔔"
                           FontSize="16"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- Cart badge pill with glow -->
                <Button x:Name="CartButton"
                        Text="🛒  0"
                        BackgroundColor="{StaticResource BrandGreen}"
                        TextColor="{StaticResource TextWhite}"
                        FontSize="13"
                        FontAttributes="Bold"
                        CornerRadius="20"
                        Padding="14,8"
                        HeightRequest="42"
                        Clicked="OnCartButtonClicked">
                    <Button.Shadow>
                        <Shadow Brush="#66FF6B4A" Offset="0,3" Radius="10" Opacity="0.4" />
                    </Button.Shadow>
                </Button>
            </HorizontalStackLayout>
        </Grid>

        <!-- ══ PREMIUM DARK SEARCH BAR ═══════════════════════════ -->
        <Border Grid.Row="1"
                BackgroundColor="{StaticResource CardBgElevated}"
                StrokeThickness="1.2"
                Stroke="{StaticResource CardBorder}"
                StrokeShape="RoundRectangle 22"
                Padding="16,0"
                Margin="16,6,16,0">
            <Border.Shadow>
                <Shadow Brush="#44000000" Offset="0,3" Radius="10" Opacity="0.3" />
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Label Grid.Column="0"
                       Text="🔍"
                       FontSize="16"
                       VerticalOptions="Center"
                       TextColor="{StaticResource TextSecondary}" />
                <SearchBar x:Name="ProductSearchBar"
                           Grid.Column="1"
                           Placeholder="Search dishes, drinks, desserts…"
                           BackgroundColor="Transparent"
                           FontSize="13"
                           TextColor="{StaticResource TextPrimary}"
                           PlaceholderColor="{StaticResource TextMuted}"
                           TextChanged="OnSearchTextChanged" />
                <!-- Filter icon (Interactive) -->
                <Border x:Name="FilterOptionsBorder"
                        Grid.Column="2"
                        BackgroundColor="{StaticResource BrandGreenLight}"
                        StrokeThickness="1"
                        Stroke="{StaticResource BrandGreen}"
                        StrokeShape="RoundRectangle 10"
                        Padding="8,6"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFilterIconTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="⊞"
                           FontSize="13"
                           TextColor="{StaticResource BrandGreen}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- ══ CATEGORY PILLS ════════════════════════════════════ -->
        <CollectionView x:Name="CategoryCollectionView"
                        Grid.Row="2"
                        HeightRequest="52"
                        Margin="12,10,12,0"
                        SelectionMode="None"
                        ItemSizingStrategy="MeasureFirstItem">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Button Text="{Binding DisplayText}"
                            BackgroundColor="{Binding BackgroundColor}"
                            TextColor="{Binding TextColor}"
                            BorderColor="{Binding BorderColor}"
                            BorderWidth="1.2"
                            CornerRadius="24"
                            Padding="18,7"
                            Margin="2,4"
                            FontSize="13"
                            FontAttributes="Bold"
                            CommandParameter="{Binding .}"
                            Clicked="OnCategoryPillClicked" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- ══ DOUBLE-COLUMN PRODUCT CARD GRID ═══════════════════ -->
        <CollectionView x:Name="ProductsCollectionView"
                        Grid.Row="3"
                        Margin="12,10,12,0"
                        SelectionMode="None"
                        ItemSizingStrategy="MeasureFirstItem"
                        RemainingItemsThreshold="4"
                        RemainingItemsThresholdReachedCommand="{x:Null}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="2"
                                 HorizontalItemSpacing="10"
                                 VerticalItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <!-- ── Empty State ── -->
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="10"
                                     Padding="0,60,0,0">
                    <Label Text="🔍"
                           FontSize="64"
                           HorizontalOptions="Center" />
                    <Label Text="No dishes found"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           HorizontalOptions="Center" />
                    <Label Text="Try another craving or reset your category."
                           FontSize="13"
                           TextColor="{StaticResource TextSecondary}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                    <Button Text="Clear Search"
                            Style="{StaticResource BtnGreen}"
                            WidthRequest="180"
                            HeightRequest="44"
                            Margin="0,8,0,0"
                            HorizontalOptions="Center"
                            Clicked="OnClearSearchClicked" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <!-- ── Product Card ── -->
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="1"
                            BackgroundColor="{StaticResource CardBg}"
                            StrokeThickness="1.2"
                            Stroke="{StaticResource CardBorder}"
                            StrokeShape="RoundRectangle 20"
                            Padding="0">
                        <Border.Shadow>
                            <Shadow Brush="#66000000" Offset="0,4" Radius="14" Opacity="0.35" />
                        </Border.Shadow>

                        <VerticalStackLayout Padding="12,12,12,12" Spacing="6">

                            <!-- Top Badges Row: Category & Rating -->
                            <Grid ColumnDefinitions="*,Auto">
                                <!-- Category badge — coral tint -->
                                <Border Grid.Column="0"
                                        BackgroundColor="{StaticResource BrandGreenLight}"
                                        StrokeThickness="1"
                                        Stroke="#44FF6B4A"
                                        StrokeShape="RoundRectangle 8"
                                        HorizontalOptions="Start"
                                        Padding="7,3">
                                    <Label Text="{Binding Category}"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource BrandGreen}" />
                                </Border>

                                <!-- Rating badge -->
                                <Border Grid.Column="1"
                                        BackgroundColor="#22262B"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="6,3">
                                    <HorizontalStackLayout Spacing="3">
                                        <Label Text="⭐" FontSize="9" VerticalOptions="Center" />
                                        <Label Text="4.9"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>

                            <!-- Product Name -->
                            <Label Text="{Binding Name}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   LineBreakMode="WordWrap"
                                   MaxLines="2"
                                   MinimumHeightRequest="36" />

                            <!-- Stock indicator -->
                            <Label Text="{Binding StockQuantity, StringFormat='⚡ {0} left in stock'}"
                                   FontSize="11"
                                   TextColor="{StaticResource TextSecondary}" />

                            <!-- Divider -->
                            <BoxView HeightRequest="1"
                                     Color="{StaticResource CardBorder}"
                                     Margin="0,2" />

                            <!-- Price & Quick + Add CTA Row -->
                            <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                <Label Grid.Column="0"
                                       Text="{Binding Price, StringFormat='${0:F2}'}"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource BrandGreen}"
                                       VerticalOptions="Center" />

                                <!-- Quick + Add Button -->
                                <Button Grid.Column="1"
                                        Text="＋ Add"
                                        BackgroundColor="{StaticResource BrandGreen}"
                                        TextColor="{StaticResource TextWhite}"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        CornerRadius="16"
                                        HeightRequest="34"
                                        Padding="10,0"
                                        CommandParameter="{Binding .}"
                                        Clicked="OnAddToCartClicked">
                                    <Button.Shadow>
                                        <Shadow Brush="#55FF6B4A" Offset="0,2" Radius="8" Opacity="0.35" />
                                    </Button.Shadow>
                                </Button>
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
